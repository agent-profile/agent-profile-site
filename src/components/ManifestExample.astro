---
interface Props {
  manifest: Record<string, unknown>;
}

const { manifest } = Astro.props;
const manifestJson = JSON.stringify(manifest, null, 2);
---

<figure class="manifest">
  <figcaption><code>profile.json</code></figcaption>
  <pre
    aria-label="Example profile.json"
    tabindex="0"><code>{manifestJson}</code></pre>
</figure>
