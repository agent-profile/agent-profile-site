---
interface Props {
  content: {
    project: { name: string; version: string };
    links: {
      specification: string;
      siteRepository: string;
      license: string;
    };
    labels: {
      specification: string;
      schema: string;
      github: string;
      external: string;
      footerNavigation: string;
      licensing: string;
    };
    licenseSummary: string;
  };
}

const { content } = Astro.props;
const schemaHref = `${import.meta.env.BASE_URL}schemas/0.0.1/profile.schema.json`;
---

<footer class="site-footer shell">
  <div>
    <p class="footer-name">{content.project.name}</p>
    <p>{content.licenseSummary}</p>
  </div>
  <nav aria-label={content.labels.footerNavigation}>
    <a href={content.links.specification}
      >{content.labels.specification}
      {" "}
      {content.project.version}<span aria-hidden="true">↗</span><span
        class="sr-only">{content.labels.external}</span
      ></a
    >
    <a href={schemaHref}>{content.labels.schema}</a>
    <a href={content.links.siteRepository}
      >{content.labels.github}<span aria-hidden="true">↗</span><span
        class="sr-only">{content.labels.external}</span
      ></a
    >
    <a href={content.links.license}
      >{content.labels.licensing}<span aria-hidden="true">↗</span><span
        class="sr-only">{content.labels.external}</span
      ></a
    >
  </nav>
</footer>
