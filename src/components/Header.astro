---
interface Props {
  content: {
    project: { name: string; version: string };
    links: { specification: string; specRepository: string };
  };
}

const { content } = Astro.props;
const base = import.meta.env.BASE_URL;
const schemaHref = `${base}schemas/0.0.1/profile.schema.json`;
---

<header class="site-header shell">
  <a class="brand" href={base} aria-label="Agent Profile home">
    <img src={`${base}favicon.svg`} alt="" width="36" height="36" />
    <span>{content.project.name}</span>
  </a>
  <nav aria-label="Primary">
    <a href={content.links.specification}>
      Specification {content.project.version}<span aria-hidden="true">↗</span>
      <span class="sr-only"> (external)</span>
    </a>
    <a href={schemaHref}>JSON Schema</a>
    <a href={content.links.specRepository}>
      GitHub<span aria-hidden="true">↗</span>
      <span class="sr-only"> (external)</span>
    </a>
  </nav>
</header>
