---
interface Item {
  key: string;
  label: string;
  body: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section class="anatomy shell" aria-labelledby="anatomy-title">
  <div class="section-heading">
    <p class="eyebrow">Profile anatomy</p>
    <h2 id="anatomy-title">What a profile describes</h2>
  </div>
  <ol class="anatomy-list">
    {
      items.map((item) => (
        <li id={`profile-${item.key}`}>
          <h3>{item.label}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ol>
</section>
