---
interface Props {
  manifest: Record<string, unknown>;
  labels: { manifestFilename: string; manifestExample: string };
}

const { manifest, labels } = Astro.props;
const manifestJson = JSON.stringify(manifest, null, 2);
---

<figure class="manifest">
  <figcaption><code>{labels.manifestFilename}</code></figcaption>
  <pre
    aria-label={labels.manifestExample}
    tabindex="0"><code>{manifestJson}</code></pre>
</figure>
